generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                      String       @id @default(uuid())
  email                   String       @unique
  username                String       @unique
  password                String
  refreshToken            String?
  bio                     String?
  avatarUrl               String?
  isEmailVerified         Boolean      @default(false)
  emailVerificationToken  String?
  resetPasswordToken      String?
  resetPasswordExpires    DateTime?
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  isOnline   Boolean  @default(false)
  lastSeenAt DateTime @default(now())

  hiddenMessages MessageHide[]

  sentRequests      Friendship[] @relation("SentRequests")
  receivedRequests  Friendship[] @relation("ReceivedRequests")
  blockedUsers      Block[]      @relation("BlockerRelation")
  blockedByUsers    Block[]      @relation("BlockedRelation")

  conversationMemberships ConversationMember[]
  sentMessages            Message[]
  groupJoinRequestsReceived GroupJoinRequest[] @relation("ProposedUser")
  groupJoinRequestsMade     GroupJoinRequest[] @relation("RequestedBy")
}
enum FriendshipStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model Friendship {
  id           String            @id @default(uuid())
  senderId     String
  receiverId   String
  status       FriendshipStatus  @default(PENDING)
  declineCount Int               @default(0)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  sender      User              @relation("SentRequests", fields: [senderId], references: [id], onDelete: Cascade)
  receiver    User              @relation("ReceivedRequests", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
}
model Block {
  id         String   @id @default(uuid())
  blockerId  String
  blockedId  String
  createdAt  DateTime @default(now())

  blocker    User     @relation("BlockerRelation", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked    User     @relation("BlockedRelation", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
}
enum ConversationType {
  PRIVATE
  GROUP
}

model Conversation {
  id        String            @id @default(uuid())
  type      ConversationType  @default(PRIVATE)
  name      String?
  avatarUrl String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  members   ConversationMember[]
  messages  Message[]
  joinRequests GroupJoinRequest[]
}

enum MemberRole {
  ADMIN
  MEMBER
}

model ConversationMember {
  id             String       @id @default(uuid())
  conversationId String
  userId         String
  role           MemberRole   @default(MEMBER)
  joinedAt       DateTime     @default(now())
  lastReadAt     DateTime     @default(now())
  hiddenAt       DateTime?

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  senderId       String
  content        String?
  imageUrl       String?
  documentUrl    String?
  isEdited       Boolean      @default(false)
  isDeleted      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  hiddenBy  MessageHide[]

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
}
enum JoinRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model GroupJoinRequest {
  id             String            @id @default(uuid())
  conversationId String
  userId         String            // la personne qu'on propose d'ajouter
  requestedById  String            // le membre qui propose cet ajout
  status         JoinRequestStatus @default(PENDING)
  createdAt      DateTime          @default(now())

  conversation   Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User              @relation("ProposedUser", fields: [userId], references: [id], onDelete: Cascade)
  requestedBy    User              @relation("RequestedBy", fields: [requestedById], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
}
model MessageHide {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  createdAt DateTime @default(now())

  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
}