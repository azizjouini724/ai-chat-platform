{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "fix-shadcn": "powershell -Command \"if (Test-Path '@') { Get-ChildItem '@' -Recurse -File | ForEach-Object { $dest = $_.FullName -replace [regex]::Escape((Resolve-Path '@').Path), (Resolve-Path 'src').Path; New-Item -ItemType Directory -Force -Path (Split-Path $dest) | Out-Null; Move-Item $_.FullName $dest -Force }; Remove-Item '@' -Recurse -Force }\"",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
